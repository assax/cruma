@* Nevratná akce s explicitním potvrzením druhým kliknutím (FR-5 akc. 3). *@
@if (confirming)
{
    <span class="confirm">
        <span>@Question</span>
        <button type="button" class="cruma-button danger" @onclick="ConfirmAsync">@ConfirmText</button>
        <button type="button" class="cruma-button" @onclick="() => confirming = false">Zrušit</button>
    </span>
}
else
{
    <button type="button" class="cruma-button @CssClass" disabled="@Disabled" @onclick="() => confirming = true">@Text</button>
}

@code {
    private bool confirming;

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string Question { get; set; } = "Opravdu?";

    [Parameter]
    public string ConfirmText { get; set; } = "Ano";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback Confirmed { get; set; }

    private async Task ConfirmAsync()
    {
        confirming = false;
        await Confirmed.InvokeAsync();
    }
}
