<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Cruma.Desktop.Program</StartupObject>
    <Version>0.1.0</Version>
    <ApplicationTitle>Cruma</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cruma.Ui\Cruma.Ui.csproj" />
    <ProjectReference Include="..\Cruma.Desktop.Storage\Cruma.Desktop.Storage.csproj" />
    <ProjectReference Include="..\Cruma.Sync.Client\Cruma.Sync.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vlastní Main kvůli Velopacku: App.xaml je stránka, ne definice aplikace s generovaným Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
