<?xml version="1.0" encoding="utf-8"?>
<!-- Jediný zdroj balíčků: nuget.org. Zdroje z uživatelské konfigurace se nepoužijí (reprodukovatelný build lokálně i v CI). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
