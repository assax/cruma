# Vzor pro deploy/.env (necommituje se – SEC-006). Zkopírovat a vyplnit.

# --- Vývoj ---
CRUMA_DEV_DB_PASSWORD=

# --- Produkce (deploy/deploy.sh) ---
# Doména s DNS záznamem na server (T-56); Caddy pro ni sám získá certifikát.
CRUMA_DOMAIN=
CRUMA_DB_PASSWORD=
# Image serveru; verzi předává deploy.sh.
CRUMA_SERVER_IMAGE=ghcr.io/assax/cruma-server
# Google OAuth (T-19) s redirect URI https://<doména>/signin-google
CRUMA_GOOGLE_CLIENT_ID=
CRUMA_GOOGLE_CLIENT_SECRET=
CRUMA_MINIMUM_DESKTOP_VERSION=0.1.0

# Zálohy restic mimo server (T-56, FR-36): např. s3:https://fsn1.your-objectstorage.com/cruma-backups
RESTIC_REPOSITORY=
# Šifrovací heslo záloh – uschovat mimo server i mimo úložiště záloh (NFR-9).
RESTIC_PASSWORD=
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
CRUMA_BACKUP_TIME=03:30

# Porty proxy (výchozí 80/443; pro zkoušku nanečisto na vývojovém počítači jiné).
CRUMA_HTTP_PORT=80
CRUMA_HTTPS_PORT=443
