# Reverzní proxy Cruma (deployment-pattern.md §2): automatické certifikáty Let's Encrypt, jen HTTPS (SEC-008).
# Pro „localhost“ použije Caddy vlastní lokální certifikační autoritu (zkouška nanečisto).
{$CRUMA_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy server:8080
}
